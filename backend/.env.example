# ════════════════════════════════════════════════════════
#   ECOSYSTEM OS BACKEND — Environment Variables
#   Copy to .env and fill in values
# ════════════════════════════════════════════════════════

NODE_ENV=development
PORT=3501

# Same physical Postgres database launchpad_v5's own backend uses — copy the
# exact value of launchpad_v5/backend/.env's DATABASE_URL. This app must never
# run `prisma db push` or `prisma migrate` against it — launchpad_v5 is the
# sole schema owner; this app only runs `prisma generate`.
DATABASE_URL="postgresql://parambeernegi@localhost:5432/founderos_dev"

# Must exactly match launchpad_v5/backend/.env's JWT_SECRET — this is how
# ecosystem-os verifies the 30-day, startup-scoped bridge token minted by
# GET /api/ecosystem-os/bridge on launchpad_v5's own backend.
LAUNCHPAD_JWT_SECRET=

# Own Anthropic key for the mapper's AI generation (/api/ai/raw) — this app
# never calls back into launchpad_v5's API at runtime, so it needs its own key
# rather than proxying through launchpad's.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

# Origins allowed to call this API — the ecosystem-os frontend's own URL(s)
ALLOWED_ORIGINS=http://localhost:3500
